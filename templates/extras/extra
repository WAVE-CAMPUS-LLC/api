{% comment %} <section id="stage-section">
                <input type="hidden" class="section-title" value="Stage 2 - Provide event ticketing information — WAVE." />
                <div class="stageSection-container-row">
                    <div id="section-description">
                        <h3>Stage 2</h3>
                        <h4>
                            Provide ticketing details
                        </h4>
                        <p>
                            Give us some information regarding tickets. You determine all types of tickets that should be made available. 
                            You can set the number of tickets available depending on the number of seats available.
                        </p>
                    </div>
            
                    <div id="section-image">
                        <img src="{% static "images/eventManagementApp/host/images/stage2.jpg" %}" />
                    </div>
                </diV>
            </section>

            <section id="stage-section">
                <input type="hidden" class="section-title" value="Tickets made available  — WAVE." />
                <div class="stageSection-container-col">
                    <div class="section-question">
                        {{ eventTicketForm.ticket_total.label }}
                        <p>Ticket availability is dependent on number of seats available.</p>
                    </div>
        
                    <div class="section-intake">
                        <div class="ticket-count-intake">
                            <button id="removeTicketCount" type="button">
                                <img src="{% static "images/eventManagementApp/host/minus.svg" %}" />
                            </button>
                            <input type="text" class="ticketCountInput" />
                            <button id="addTicketCount" type="button">
                                <img src="{% static "images/eventManagementApp/host/add.svg" %}" />
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <section id="stage-section">
                <input type="hidden" class="section-title" value="Tickets made available  — WAVE." />
                <div class="stageSection-container-col">
                    <div class="section-question">
                        {{ eventTicketForm.type_total.label }}
                        <p>General admission, VIP, early bird, front-seat, etc. <span>No more than 5!</span></p>
                    </div>
        
                    <div class="section-intake">
                        <div class="ticket-count-intake">
                            <button id="removeTicketTypeCount" type="button">
                                <img src="{% static "images/eventManagementApp/host/minus.svg" %}" />
                            </button>
                            <input type="{{ eventTicketForm.time.field.widget.input_type }}" id="{{ eventForm.time.auto_id }}" name="{{ eventForm.time.html_name }}" class="ticketTypeCountInput" max="5" />
                            <button id="addTicketTypeCount" type="button">
                                <img src="{% static "images/eventManagementApp/host/add.svg" %}" />
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <section id="stage-section">
                <input type="hidden" class="section-title" value="Tickets made available  — WAVE." />
                <div class="stageSection-container-col">
                    <div class="section-question">
                        Set ticket types and quantity. 
                    </div>
        
                    <div class="ticket-section-intake">
                        {{  ticket_type_formset.management_form }}
                        {% for form in ticket_type_formset %}
                        <div class="ticket-type-row">
                            <label>
                                <p>Type name (e.g. VIP)</p>
                                <input type="text" />
                            </label>
                            <label>
                                <p>Type quantity (e.g. 10)</p>
                                <input type="text" />
                            </label>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </section> {% endcomment %}